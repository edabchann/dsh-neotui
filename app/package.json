{
  "name": "dsh-neotui-app",
  "version": "0.3.0",
  "description": "dsh-neotui bundle: keyboard-first terminal surface over dsh-base with embedded API access",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.js",
    "./startup": "./src/startup.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-cmdline": "*",
    "commander": "*",
    "dsh-neotui": "0.3.0"
  },
  "license": "MIT"
}
